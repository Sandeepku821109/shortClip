# Server
PORT=3000
NODE_ENV=development

# Upload config (no size limit - on-device storage)
MAX_VIDEO_DURATION_SECONDS=1800
MAX_CLIPS_PER_JOB=5

# Expiration (in minutes)
SOURCE_EXPIRATION_MINUTES=30
CLIP_EXPIRATION_MINUTES=30

# Processing
PROCESSING_TIMEOUT_SECONDS=1800
CLEANUP_INTERVAL_SECONDS=60

# Paths
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
PYTHON_PATH=python
STORAGE_PATH=./storage

# Transcription (optional)
# Leave empty to skip transcription
TRANSCRIPTION_PROVIDER=
TRANSCRIPTION_API_KEY=

# CORS - Set to your Vercel frontend URL for production
CORS_ORIGIN=http://localhost:5173

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=10

# YouTube URL processing (paste a YouTube URL to download & clip)
# yt-dlp is bundled with the Docker image; override only if needed
YTDLP_PATH=yt-dlp

# YouTube Data API v3 auto-upload (optional).
# Requires Google Cloud OAuth 2.0 credentials + the YouTube Data API v3 enabled.
# Leave blank to disable automatic YouTube uploads (clips still downloadable).
# See: https://developers.google.com/youtube/v3
YOUTUBE_API_KEY=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# Comma-separated emails allowed to upload (optional access control)
YOUTUBE_AUTHORIZED_EMAILS=

# ============================================
# Railway Deployment Notes:
# ============================================
# Railway automatically sets PORT environment variable
# FFmpeg is pre-installed via Dockerfile
# Python is pre-installed via Dockerfile
# yt-dlp is pre-installed via Dockerfile
# Set CORS_ORIGIN to your Vercel deployment URL
# Example: CORS_ORIGIN=https://shortclip.vercel.app
